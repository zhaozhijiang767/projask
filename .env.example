# 复制为 .env 后填写；.env 不入库
# ---- 运行环境 ----
PROJASK_ENV=development

# ---- 数据库账号与口令 ----
PROJASK_DB_META_USER=meta
PROJASK_DB_META_PASSWORD=
PROJASK_DB_DW_USER=dw
PROJASK_DB_DW_PASSWORD=
# 生产必填：只读账号，只有语义层视图的 SELECT 权限
PROJASK_DB_DW_READER_USER=dw_reader
PROJASK_DB_DW_READER_PASSWORD=

# ---- 大模型 ----
PROJASK_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
PROJASK_LLM_MODEL_NAME=deepseek-ai/DeepSeek-V4-Pro-0813
PROJASK_LLM_FAST_MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash-1017
PROJASK_LLM_API_KEY=

# ---- 认证 ----
PROJASK_AUTH_MODE=none
PROJASK_SCOPE_MODE=none
PROJASK_COOKIE_SECURE=false

# ---- Redis（必填，无默认降级）----
PROJASK_REDIS_PASSWORD=

# ---- 容器内主机名覆盖（docker-compose 使用）----
# PROJASK_DB_META_HOST=oracle
# PROJASK_DB_DW_HOST=oracle
# PROJASK_QDRANT_HOST=qdrant
# PROJASK_EMBEDDING_HOST=embedding
# PROJASK_ES_HOST=elasticsearch
# PROJASK_MONGO_HOST=mongodb
# PROJASK_REDIS_HOST=redis